<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:background="@drawable/bg_bottom_nav"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/navItemTable"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="2dp"
        android:layout_weight="1"
        android:background="@drawable/sel_nav_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:fontFamily="@font/space_grotesk"
            android:includeFontPadding="false"
            android:text="@string/nav_table_map"
            android:textAllCaps="true"
            android:textColor="@color/nav_item_color"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navItemKitchen"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="2dp"
        android:layout_weight="1"
        android:background="@drawable/sel_nav_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:fontFamily="@font/space_grotesk"
            android:includeFontPadding="false"
            android:text="@string/nav_kitchen"
            android:textAllCaps="true"
            android:textColor="@color/nav_item_color"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navItemMenu"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="2dp"
        android:layout_weight="1"
        android:background="@drawable/sel_nav_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:fontFamily="@font/space_grotesk"
            android:includeFontPadding="false"
            android:text="@string/nav_menu"
            android:textAllCaps="true"
            android:textColor="@color/nav_item_color"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navItemManagement"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="2dp"
        android:layout_weight="1"
        android:background="@drawable/sel_nav_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:fontFamily="@font/space_grotesk"
            android:includeFontPadding="false"
            android:text="@string/nav_management"
            android:textAllCaps="true"
            android:textColor="@color/nav_item_color"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

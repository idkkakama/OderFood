<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_header"
    android:elevation="3dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <TextView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_logo_tile"
        android:fontFamily="@font/material_symbols_outlined"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/sym_restaurant"
        android:textColor="@color/on_primary_container"
        android:textSize="22sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/brand_name"
                android:textAllCaps="true"
                android:textColor="@color/on_surface_variant"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/material_symbols_outlined"
                android:includeFontPadding="false"
                android:text="@string/sym_expand_more"
                android:textColor="@color/outline"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHeaderTitle"
            style="@style/Text.QLNH.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/screen_table_map"
            android:textSize="19sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_pill"
        android:backgroundTint="@color/primary_container"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="@string/role_badge"
        android:textColor="@color/on_primary_container"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.06" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgProfile"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/brand_name"
        android:scaleType="centerCrop"
        android:src="@drawable/avatar_profile"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.QLNH.Circle"
        app:strokeWidth="0dp" />
</LinearLayout>

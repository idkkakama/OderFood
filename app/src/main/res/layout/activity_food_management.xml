<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <include layout="@layout/include_app_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Back Button -->
        <TextView
            android:id="@+id/btnBackMgmt"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="@color/surface_container"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="←"
            android:textColor="@color/on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Quản lý thực đơn"
            android:textColor="@color/on_surface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAddFood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="+ Thêm món ăn mới" />

        <!-- Search Bar -->
        <EditText
            android:id="@+id/etFoodMgmtSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_surface_low_rounded"
            android:hint="🔍 Tìm tên món ăn hoặc mô tả..."
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/outline"
            android:textSize="14sp" />

        <!-- Category Horizontal Filter -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipMgmtAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_active"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Tất cả"
                    android:textColor="@color/on_primary_container"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipMgmtMains"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Món chính"
                    android:textColor="@color/on_surface"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipMgmtStarters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Món khai vị"
                    android:textColor="@color/on_surface"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipMgmtSoups"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Món canh &amp; Rau"
                    android:textColor="@color/on_surface"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipMgmtDrinks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Đồ uống"
                    android:textColor="@color/on_surface"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/adminFoodList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="28dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_surface_high_rounded"
                android:fontFamily="@font/material_symbols_outlined"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:text="@string/sym_restaurant_menu"
                android:textColor="@color/primary_container"
                android:textSize="30sp" />

            <TextView
                style="@style/Text.QLNH.HeadlineLG"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/auth_login_title" />

            <TextView
                style="@style/Text.QLNH.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/auth_login_subtitle"
                android:textColor="@color/outline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_surface_low_rounded"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Text.QLNH.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_email_label"
                    android:textAllCaps="true"
                    android:textColor="@color/on_surface_variant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/sel_auth_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/material_symbols_outlined"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:text="@string/sym_alternate_email"
                        android:textColor="@color/outline"
                        android:textSize="20sp" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:autofillHints="emailAddress"
                        android:background="@null"
                        android:hint="@string/auth_email_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:paddingStart="0dp"
                        android:paddingEnd="4dp"
                        android:textColor="@color/on_surface"
                        android:textColorHint="@color/outline_variant"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    style="@style/Text.QLNH.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/auth_password_label"
                    android:textAllCaps="true"
                    android:textColor="@color/on_surface_variant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/sel_auth_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/material_symbols_outlined"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:text="@string/sym_lock"
                        android:textColor="@color/outline"
                        android:textSize="20sp" />

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:autofillHints="password"
                        android:background="@null"
                        android:hint="@string/auth_password_hint"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:paddingStart="0dp"
                        android:paddingEnd="4dp"
                        android:textColor="@color/on_surface"
                        android:textColorHint="@color/outline_variant"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnTogglePassword"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/auth_password_label"
                        android:focusable="true"
                        android:fontFamily="@font/material_symbols_outlined"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/sym_visibility"
                        android:textColor="@color/outline"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbRemember"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:checked="true"
                        android:text="@string/auth_remember"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        app:buttonTint="@color/primary_container" />

                    <TextView
                        android:id="@+id/btnForgotPassword"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="end|center_vertical"
                        android:text="@string/auth_forgot_password"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        style="@style/Widget.QLNH.Button"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/auth_login_action"
                        android:textSize="14sp"
                        app:cornerRadius="8dp"
                        app:icon="@null"
                        app:iconGravity="textEnd"
                        app:iconPadding="8dp" />

                    <ProgressBar
                        android:id="@+id/progressLogin"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/on_primary_container"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/outline_variant" />

                    <TextView
                        style="@style/Text.QLNH.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/auth_shift_divider"
                        android:textColor="@color/outline" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/outline_variant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPinLogin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_dark"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/material_symbols_outlined"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:text="@string/sym_dialpad"
                        android:textColor="@color/secondary"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/auth_pin_login"
                        android:textColor="@color/on_surface"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.QLNH.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_no_account"
                    android:textColor="@color/outline" />

                <TextView
                    android:id="@+id/btnRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:padding="6dp"
                    android:text="@string/auth_register_now"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_header"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/auth_back"
            android:focusable="true"
            android:fontFamily="@font/material_symbols_outlined"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/sym_arrow_back"
            android:textColor="@color/on_surface_variant"
            android:textSize="24sp" />

        <TextView
            style="@style/Text.QLNH.LabelLarge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/auth_register_header"
            android:textAllCaps="true"
            android:textColor="@color/on_surface" />

        <TextView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_auth_avatar"
            android:fontFamily="@font/material_symbols_outlined"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:text="@string/sym_person"
            android:textColor="@color/on_primary"
            android:textSize="19sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/material_symbols_outlined"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="@string/sym_encrypted"
                    android:textColor="@color/primary_container"
                    android:textSize="18sp" />

                <TextView
                    style="@style/Text.QLNH.LabelSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/auth_access"
                    android:textAllCaps="true"
                    android:textColor="@color/on_surface_variant"
                    android:letterSpacing="0.1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_pill"
                    android:backgroundTint="@color/surface_container_highest"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="7dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="3dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_dot"
                        android:backgroundTint="@color/tertiary"
                        android:importantForAccessibility="no" />

                    <TextView
                        style="@style/Text.QLNH.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/auth_system_ready"
                        android:textColor="@color/tertiary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_lowest_rounded"
                android:orientation="vertical"
                android:padding="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnRoleOwner"
                        android:layout_width="0dp"
                        android:layout_height="62dp"
                        android:layout_weight="1"
                        android:background="@drawable/sel_auth_role"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <TextView
                            android:id="@+id/iconRoleOwner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/material_symbols_outlined"
                            android:importantForAccessibility="no"
                            android:includeFontPadding="false"
                            android:text="@string/sym_storefront"
                            android:textColor="@color/primary"
                            android:textSize="20sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvRoleOwner"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/auth_owner"
                                android:textColor="@color/on_surface"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvRoleOwnerDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="@string/auth_owner_desc"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnRoleStaff"
                        android:layout_width="0dp"
                        android:layout_height="62dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/sel_auth_role"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <TextView
                            android:id="@+id/iconRoleStaff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/material_symbols_outlined"
                            android:importantForAccessibility="no"
                            android:includeFontPadding="false"
                            android:text="@string/sym_skillet"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="20sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvRoleStaff"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/auth_staff"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvRoleStaffDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="@string/auth_staff_desc"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <TextView
                    style="@style/Text.QLNH.LabelSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/auth_full_name_label"
                    android:textAllCaps="true"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/material_symbols_outlined"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="@string/sym_badge"
                    android:textColor="@color/outline"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/sel_auth_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/material_symbols_outlined"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="@string/sym_person"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="20sp" />

                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autofillHints="name"
                    android:background="@null"
                    android:hint="@string/auth_full_name_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:paddingStart="0dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/outline_variant"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <TextView
                    style="@style/Text.QLNH.LabelSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/auth_email_label"
                    android:textAllCaps="true"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/material_symbols_outlined"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="@string/sym_contact_phone"
                    android:textColor="@color/outline"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/sel_auth_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/material_symbols_outlined"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="@string/sym_alternate_email"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="20sp" />

                <EditText
                    android:id="@+id/etRegisterEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autofillHints="emailAddress"
                    android:background="@null"
                    android:hint="@string/auth_email_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:paddingStart="0dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/outline_variant"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/groupInviteCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <TextView
                        style="@style/Text.QLNH.LabelSmall"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/auth_invite_label"
                        android:textAllCaps="true"
                        android:textColor="@color/secondary" />

                    <TextView
                        style="@style/Text.QLNH.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_invite_tag"
                        android:textColor="@color/secondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="6dp"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/sel_auth_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/material_symbols_outlined"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:text="@string/sym_group_add"
                        android:textColor="@color/secondary"
                        android:textSize="20sp" />

                    <EditText
                        android:id="@+id/etInviteCode"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/auth_invite_hint"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="textCapCharacters"
                        android:letterSpacing="0.12"
                        android:maxLines="1"
                        android:paddingStart="0dp"
                        android:paddingEnd="4dp"
                        android:textAllCaps="true"
                        android:textColor="@color/secondary"
                        android:textColorHint="@color/outline_variant"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <TextView
                    style="@style/Text.QLNH.LabelSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/auth_password_label"
                    android:textAllCaps="true"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    style="@style/Text.QLNH.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_password_min"
                    android:textColor="@color/outline" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/sel_auth_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/material_symbols_outlined"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="@string/sym_lock"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="20sp" />

                <EditText
                    android:id="@+id/etRegisterPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autofillHints="newPassword"
                    android:background="@null"
                    android:hint="@string/auth_password_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingStart="0dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/outline_variant"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnToggleRegisterPassword"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/auth_password_label"
                    android:focusable="true"
                    android:fontFamily="@font/material_symbols_outlined"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/sym_visibility"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <View
                    android:id="@+id/strengthBar1"
                    android:layout_width="28dp"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_strength_bar"
                    android:importantForAccessibility="no" />

                <View
                    android:id="@+id/strengthBar2"
                    android:layout_width="28dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_strength_bar"
                    android:importantForAccessibility="no" />

                <View
                    android:id="@+id/strengthBar3"
                    android:layout_width="28dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_strength_bar"
                    android:importantForAccessibility="no" />

                <View
                    android:id="@+id/strengthBar4"
                    android:layout_width="28dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_strength_bar"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvStrength"
                    style="@style/Text.QLNH.LabelSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/auth_password_empty"
                    android:textColor="@color/outline" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <TextView
                    style="@style/Text.QLNH.LabelSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/auth_confirm_password_label"
                    android:textAllCaps="true"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/iconMatch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/material_symbols_outlined"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="@string/sym_verified_user"
                    android:textColor="@color/outline"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/sel_auth_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/material_symbols_outlined"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="@string/sym_shield"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="20sp" />

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autofillHints="newPassword"
                    android:background="@null"
                    android:hint="@string/auth_password_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingStart="0dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/outline_variant"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnToggleConfirmPassword"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/auth_confirm_password_label"
                    android:focusable="true"
                    android:fontFamily="@font/material_symbols_outlined"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/sym_visibility"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="top"
                android:orientation="horizontal">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbTerms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    app:buttonTint="@color/primary_container" />

                <TextView
                    android:id="@+id/tvTerms"
                    style="@style/Text.QLNH.BodySmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/auth_terms_agreement"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateAccount"
                    style="@style/Widget.QLNH.Button"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="@string/auth_create_account"
                    android:textSize="14sp"
                    app:cornerRadius="8dp" />

                <ProgressBar
                    android:id="@+id/progressRegister"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/on_primary_container"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_surface_container_rounded"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_surface_high_rounded"
                    android:fontFamily="@font/material_symbols_outlined"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="@string/sym_speed"
                    android:textColor="@color/primary"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_setup_speed_title"
                        android:textColor="@color/on_surface"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Text.QLNH.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/auth_setup_speed_desc"
                        android:textColor="@color/on_surface_variant" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.QLNH.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_have_account"
                    android:textColor="@color/outline" />

                <TextView
                    android:id="@+id/btnGoLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:padding="6dp"
                    android:text="@string/auth_login_now"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
